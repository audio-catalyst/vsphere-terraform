#!/usr/bin/env bash
# Generated by the vsphere-cluster Terraform module. Runs once on first boot.
set -euo pipefail

LOG=/var/log/ansible-first-boot.log
exec >"$LOG" 2>&1

decode() {
  printf '%s' "$1" | base64 -d
}

repo="$(decode '${repo_b64}')"
playbook="$(decode '${playbook_b64}')"
branch="$(decode '${branch_b64}')"
directory="$(decode '${directory_b64}')"
requirements="$(decode '${requirements_b64}')"
package_name="$(decode '${package_b64}')"
extra_vars_json="$(decode '${extra_vars_b64}')"

echo "ansible-first-boot: starting $(date -u +%FT%TZ)"

if [ '${install_packages}' = 'true' ]; then
  if command -v apt-get >/dev/null 2>&1; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y git python3 python3-pip "$package_name"
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y git python3 python3-pip "$package_name"
  elif command -v yum >/dev/null 2>&1; then
    yum install -y git python3 python3-pip "$package_name"
  elif command -v apk >/dev/null 2>&1; then
    apk add --no-cache git python3 py3-pip "$package_name"
  else
    python3 -m pip install --upgrade pip "$package_name"
  fi
fi

if [ '${run_pull}' = 'true' ]; then
  mkdir -p "$directory"
  printf '%s' "$extra_vars_json" > "$directory/.ansible-extra-vars.json"

  set -- -U "$repo" -b "$branch" -d "$directory" -i 'localhost,' -e "@$directory/.ansible-extra-vars.json"
  if [ -n "$requirements" ]; then
    set -- "$@" -r "$requirements"
  fi
  set -- "$@" "$playbook"

  ansible-pull "$@"
fi

echo "ansible-first-boot: complete $(date -u +%FT%TZ)"

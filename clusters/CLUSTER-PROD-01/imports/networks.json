    },
    {
      "name": "NET-DATA",
      "resource": "vsphere_distributed_port_group.this[\"NET-DATA\"]",
      "path": "/{datacenter}/network/NET-DATA"
    },
    {
      "name": "NET-STORAGE",
      "resource": "vsphere_distributed_port_group.this[\"NET-STORAGE\"]",
      "path": "/{datacenter}/network/NET-STORAGE"
    },
    {
      "name": "NET-VSAN",
      "resource": "vsphere_distributed_port_group.this[\"NET-VSAN\"]",

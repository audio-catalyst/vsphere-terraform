{
  "name": "CLUSTER-PROD-01",
  "folder": "Compute",
  "drs_enabled": true,
  "drs_automation_level": "fullyAutomated",
  "drs_migration_threshold": 3,
  "ha_enabled": true,
  "ha_host_monitoring": "enabled",
  "ha_vm_monitoring": "vmMonitoringDisabled",
  "ha_admission_control_policy": "resourcePercentage",
  "ha_admission_control_host_failure_tolerance": 1,
  "evc_mode": "intel-skylake",
  "host_cluster_exit_timeout": 3600,
  "esxi_hosts": [
    "esxi-01.example.local",
    "esxi-02.example.local",
    "esxi-03.example.local"
  ],

  "vsan": {
    "enabled": true,
    "esa_enabled": false,
    "unmap_enabled": false,
    "dedup_enabled": true,
    "compression_enabled": true,
    "performance_enabled": true,
    "verbose_mode_enabled": false,
    "network_diagnostic_mode_enabled": false,
    "dit_encryption_enabled": false,
    "dit_rekey_interval": 1440,
    "remote_datastore_ids": [],
    "disk_groups": [
      {
        "cache": "naa.REPLACE_WITH_CACHE_DISK_ID",
        "storage": [
          "naa.REPLACE_WITH_CAPACITY_DISK_1_ID",
          "naa.REPLACE_WITH_CAPACITY_DISK_2_ID"
        ]
      }
    ],
    "fault_domains": {
      "RACK-1": ["esxi-01.example.local", "esxi-02.example.local"],
      "RACK-2": ["esxi-03.example.local"]
    },
    "stretched_cluster": {
      "preferred_hosts": [],
      "secondary_hosts": [],
      "witness_host": "",
      "preferred_domain_name": "Preferred",
      "secondary_domain_name": "Secondary"
    }
  },

  "create_networks": true,
  "vds": {
    "name": "VDS-PROD-01",
    "uplinks": ["uplink1", "uplink2"],
    "active_uplinks": ["uplink1", "uplink2"],
    "standby_uplinks": [],
    "max_mtu": 9000,
    "host_uplinks": {
      "esxi-01.example.local": ["vmnic0", "vmnic1"],
      "esxi-02.example.local": ["vmnic0", "vmnic1"],
      "esxi-03.example.local": ["vmnic0", "vmnic1"]
    }
  },
  "existing_networks": {
    "NET-MGMT": "VM Network",
    "NET-DATA": "VM Network",
    "NET-STORAGE": "VM Network",
    "NET-VSAN": "VM Network"
  }
}
